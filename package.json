{
  "name": "@sage-bionetworks/react-datasheet-grid",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sage-bionetworks/react-datasheet-grid.git"
  },
  "version": "4.11.5-sage.11",
  "description": "An Excel-like React component to create beautiful spreadsheets.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "src/style.css",
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "start": "vite preview",
    "format": "prettier --write src/. && prettier --write example/src/.",
    "lint": "eslint src/.",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "reactjs",
    "spreadsheet",
    "grid",
    "datasheet",
    "excel",
    "airtable",
    "notion",
    "table"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "author": "Nicolas Keller (https://github.com/nick-keller)",
  "type": "module",
  "license": "MIT",
  "homepage": "https://react-datasheet-grid.netlify.app/",
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jsdom": "^16.2.15",
    "@types/react": "^18.3.31",
    "@types/throttle-debounce": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^6.5.1",
    "cpx": "^1.5.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^16.7.0",
    "prettier": "^2.8.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-react": "^4.0.1",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist/**/*"
  ],
  "peerDependencies": {
    "react": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "classnames": "^2.5.1",
    "fast-deep-equal": "^3.1.3",
    "react-resize-detector": "^10.0.1",
    "throttle-debounce": "^3.0.1"
  }
}
